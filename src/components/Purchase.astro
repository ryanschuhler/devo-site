---
const { frontmatter } = Astro.props;
---

<section class="section purchase-section">
  <h4 class="section-title">{frontmatter.lang === 'en' ? 'Purchase the Book' : frontmatter.lang === 'es' ? 'Comprar el libro' : 'Adquira o livro'}</h4>
  <a class="btn purchase-btn" href={
    frontmatter.lang === 'en' 
      ? "https://www.amazon.com/Feeding-Soul-Bible-Study-Leader/dp/B0CHVZLBH7/ref=sr_1_1?crid=1E8FXPHN8M68W&keywords=feeding+the+soul+of+the+bible+study+leader&qid=1701736434&s=books&sprefix=feeding+the+soul+of+the+bible+study+leader%2Cstripbooks%2C135&sr=1-1"
      : frontmatter.lang === 'es'
      ? "https://www.amazon.com/Alimentando-Alma-Líder-Estudios-Bíblicos/dp/B0CK3QDGRJ/ref=sr_1_1?crid=YLKWGA87CF2M&keywords=ALIMENTANDO+EL+ALMA+DEL+LÍDER+DE+ESTUDIOS+BÍBLICOS&qid=1701736538&s=books&sprefix=alimentando+el+alma+del+líder+de+estudios+bíblicos%2Cstripbooks%2C1073&sr=1-1"
      : "https://www.amazon.com/Alimentando-Alma-L%C3%ADder-Estudo-B%C3%ADblico/dp/B0DFVFRH2R"
  } target="_blank">
    {frontmatter.lang === 'en' ? 'Buy Now' : frontmatter.lang === 'es' ? 'Comprar Ahora' : 'Compre Agora'}
  </a>
</section>

<style>
  .purchase-section {
    padding: var(--spacing-4);
  }
  .purchase-btn {
    width: 100%;
    box-sizing: border-box;
  }
</style>