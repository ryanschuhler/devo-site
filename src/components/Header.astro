---
import { SITE_DOMAIN, SITE_DOMAIN_ES, SITE_DOMAIN_PT, SITE_TITLE, SITE_TITLE_ES, SITE_TITLE_PT } from '../const';
import { useTranslations } from '../i18n/utils';

const { frontmatter } = Astro.props;
const currentPath = Astro.url.pathname;
const lang = (frontmatter.lang || 'en') as 'en' | 'es' | 'pt';
const t = useTranslations(lang);

let siteTitle = SITE_TITLE;
if (lang === 'es') siteTitle = SITE_TITLE_ES;
if (lang === 'pt') siteTitle = SITE_TITLE_PT;

const homePath = lang === 'en' ? '/home' : lang === 'es' ? '/inicio' : '/página-inicial';
const devotionalsPath = lang === 'en' ? '/devotionals' : lang === 'es' ? '/devocionales' : '/devocionais';
const aboutPath = lang === 'en' ? '/about' : lang === 'es' ? '/acerca-de' : '/sobre';
---

<header class="site-header">
	<h2 class="site-title"><a href="/" rel="home">{siteTitle}</a></h2>
	<nav class="language-navigation">
		<ul>
			<li><a href={ SITE_DOMAIN + '/home' }>English</a></li>
			<li><a href={ SITE_DOMAIN_ES + '/inicio' }>Español</a></li>
			<li><a href={ SITE_DOMAIN_PT + '/página-inicial' }>Português</a></li>
		</ul>
	</nav>
	<nav class="site-navigation">
		<ul>
			<li class={currentPath.includes(homePath) ? "active" : ""}><a href={homePath}>{t('nav.home')}</a></li>
			<li class={currentPath.includes(devotionalsPath) ? "active" : ""}><a href={devotionalsPath}>{t('nav.devotionals')}</a></li>
			<li class={currentPath.includes(aboutPath) ? "active" : ""}><a href={aboutPath}>{t('nav.about')}</a></li>
		</ul>
	</nav>
</header>